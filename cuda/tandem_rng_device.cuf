! Tandem8x32 inside CUDA Fortran kernels: a per-thread generator with one cached chunk state,
! the same law as tandem.cuh's device_rng. Its draws equal the C library's scalar draws for the
! same key and position, mixed widths included. Needs nvfortran -cuda.
! Copyright 2026 Jessica Cox. Apache License 2.0, see LICENSE.
!
! Fortran has no unsigned integers, so a 32-bit word is an int32 bit pattern. The step works on
! those words with no signed overflow: a product is the int64 product of the sign-extended words,
! whose high word is corrected to the unsigned one, and a sum is formed in int64 and its low word
! kept. The public tandem_dev_apply_T, _apply_F, _F_keyed and _block take words as
! int64 values in [0, 2^32). Keys and int32 draws pass as int32 bit patterns.
module tandem_rng_device
    use, intrinsic :: iso_fortran_env, only: int32, int64, real32, real64
    use tandem_zig_tables, only: ZIG_R, ZIG_W, ZIG_K, ZIG_Y
    implicit none
    private

    ! a b + c rounded once: libm's on the host, the device's in kernels.
    interface
        pure function fmad(a, b, c) result(r) bind(C, name="fma")
            import :: real64
            real(real64), value :: a, b, c
            real(real64) :: r
        end function
    end interface

    public :: tandem_dev_t
    public :: tandem_dev_from_key, tandem_dev_seed, tandem_dev_skip_to
    public :: tandem_dev_next_real64, tandem_dev_next_real32, tandem_dev_next_int64, &
        tandem_dev_next_int32, tandem_dev_next_logical
    public :: tandem_dev_next_normal64, tandem_dev_next_normal32, tandem_dev_next_normal_pair32
    public :: tandem_dev_below_int32, tandem_dev_below_int64
    public :: tandem_dev_at_real64, tandem_dev_at_real32, tandem_dev_at_int64, tandem_dev_at_int32
    public :: tandem_dev_split, tandem_dev_sub, tandem_dev_fork
    public :: tandem_dev_apply_T, tandem_dev_apply_F, tandem_dev_F_keyed, tandem_dev_block

    integer(int64), parameter :: M32 = int(z'ffffffff', int64)
    ! Flipping this bit turns the signed order of int64 into the unsigned order.
    integer(int64), parameter :: SIGN = -huge(1_int64) - 1_int64
    integer(int64), parameter :: CLOCK_WEYL = int(z'9e3779b9', int64)
    integer(int64), parameter, public :: TANDEM_DOMAIN_STREAM = int(z'9e3779b9', int64)
    integer(int64), parameter :: DOMAIN_SPLIT = int(z'bb67ae85', int64)
    integer(int64), parameter :: DOMAIN_FOLD = int(z'cd9e8d57', int64)
    integer(int64), parameter :: DOMAIN_FORK = int(z'd2511f53', int64)
    integer(int64), parameter :: DOMAIN_SEED = int(z'a54ff53a', int64)
    integer(int64), parameter, public :: TANDEM_AUX_STREAM = int(z'94d049bb', int64)
    integer(int64), parameter :: PURPOSE_NORMAL64 = int(z'4e524d3634', int64)
    ! The round constants of F as int32 bit patterns: d17cc1b7, a7220a94, fe13abe8, fa9a6ee0,
    ! edb14acc, 9e21c820, ff28b1d5, ef5de2b0.
    integer(int32), parameter :: RC(8) = [-780353097, -1490941292, -32265240, -90542368, &
        -307148084, -1641953248, -14110251, -279059792]

    ! The reference logarithm of spec Appendix A, with its coefficients as bit patterns.
    real(real64), parameter :: LOG_C(6) = transfer([4599676419421066164_int64, &
        4596373779696369217_int64, 4594314990487504468_int64, 4592671052175177768_int64, &
        4591200045223007611_int64, 4590654109678834886_int64], 1.0_real64, 6)
    real(real64), parameter :: LN2X2_HI = transfer(4608922133939093504_int64, 1.0_real64)
    real(real64), parameter :: LN2X2_LO = transfer(4465945679151235072_int64, 1.0_real64)

    ! Transport form plus one cached chunk: the state of chunk `chunk` after `step + 1` steps.
    ! Build it with tandem_dev_from_key or tandem_dev_seed. Default initialization would be
    ! natural here, but it crashes nvfortran 25.3 in device code. key holds the words as int64 values
    ! in [0, 2^32), lk is log2 K, and the cache is private: blk is the stream block that o holds,
    ! -1 before the first draw.
    type :: tandem_dev_t
        integer(int64) :: key(4)
        integer(int64) :: pos
        integer(int64) :: K
        integer, private :: lk
        integer(int64), private :: chunk
        integer(int64), private :: step
        integer(int64), private :: blk
        integer(int32), private :: o(4)
        integer(int32), private :: h(4)
        logical, private :: live
    end type

contains

    ! The low 32 bits of x as an int32 bit pattern.
    attributes(host, device) elemental function lo32(x) result(w)
        integer(int64), intent(in) :: x
        integer(int32) :: w
        w = int(iand(x, M32) - ishft(iand(x, 2_int64**31), 1), int32)
    end function

    ! The word of an int32 bit pattern, in [0, 2^32).
    attributes(host, device) elemental function u64(w) result(x)
        integer(int32), intent(in) :: w
        integer(int64) :: x
        x = iand(int(w, int64), M32)
    end function

    ! The 64-bit product of two words as low and high words. The signed product of the
    ! sign-extended words has the unsigned product's low word, and its high word differs by b
    ! when a has its top bit set and by a when b does.
    attributes(host, device) subroutine mul32w(a, b, lo, hi)
        integer(int32), intent(in) :: a, b
        integer(int32), intent(out) :: lo, hi
        integer(int64) :: sa, sb, p
        sa = int(a, int64)
        sb = int(b, int64)
        p = sa * sb
        lo = lo32(p)
        hi = lo32((p - iand(p, M32)) / 4294967296_int64 + merge(sb, 0_int64, sa < 0) + merge(sa, 0_int64, sb < 0))
    end subroutine

    ! The step T: mix the exposed half, clock the hidden half, feed o0 back into h0.
    attributes(host, device) subroutine step(o, h)
        integer(int32), intent(inout) :: o(4), h(4)
        integer(int32) :: lo0, hi0, lo1, hi1, n0, n1, n2, n3
        call mul32w(o(1), ior(h(1), 1), lo0, hi0)
        call mul32w(o(3), ior(h(2), 1), lo1, hi1)
        n0 = ieor(ieor(o(2), hi1), lo1)
        n1 = ieor(ishftc(lo1, 16), h(3))
        n2 = ieor(ieor(o(4), hi0), lo0)
        n3 = ieor(ishftc(lo0, 16), h(4))
        h(1) = ieor(h(1), ishftc(h(2), 7))
        h(2) = ieor(h(2), ishftc(h(3), 13))
        h(3) = ieor(h(3), ishftc(h(4), 22))
        h(4) = ieor(h(4), ishftc(h(1), 3))
        h(1) = ieor(lo32(int(h(1), int64) + CLOCK_WEYL), n0)
        o(1) = n0
        o(2) = n1
        o(3) = n2
        o(4) = n3
    end subroutine

    ! The seeding function F: eight rounds of T, a round constant, and a half swap.
    attributes(host, device) subroutine seed_f(o, h)
        integer(int32), intent(inout) :: o(4), h(4)
        integer(int32) :: t(4)
        integer :: r
        do r = 1, 8
            call step(o, h)
            o(1) = ieor(o(1), RC(r))
            t = o
            o = h
            h = t
        end do
    end subroutine

    ! counter is a 64-bit unsigned value as its int64 bit pattern, domain and aux are words.
    attributes(host, device) subroutine f_keyed(key, counter, domain, aux, o, h)
        integer(int32), intent(in) :: key(4)
        integer(int64), intent(in) :: counter, domain, aux
        integer(int32), intent(out) :: o(4), h(4)
        o(1) = lo32(counter)
        o(2) = lo32(ishft(counter, -32))
        o(3) = lo32(domain)
        o(4) = lo32(aux)
        h = key
        call seed_f(o, h)
    end subroutine

    attributes(host, device) subroutine block_words(key, c, j, out)
        integer(int32), intent(in) :: key(4)
        integer(int64), intent(in) :: c, j
        integer(int32), intent(out) :: out(4)
        integer(int32) :: h(4)
        integer(int64) :: s
        call f_keyed(key, c, TANDEM_DOMAIN_STREAM, TANDEM_AUX_STREAM, out, h)
        do s = 0, j
            call step(out, h)
        end do
    end subroutine

    ! The step, F, F under a key and block B(c, j) on words held as int64 values in [0, 2^32).
    attributes(host, device) subroutine tandem_dev_apply_T(o, h)
        integer(int64), intent(inout) :: o(4), h(4)
        integer(int32) :: wo(4), wh(4)
        wo = lo32(o)
        wh = lo32(h)
        call step(wo, wh)
        o = u64(wo)
        h = u64(wh)
    end subroutine

    attributes(host, device) subroutine tandem_dev_apply_F(o, h)
        integer(int64), intent(inout) :: o(4), h(4)
        integer(int32) :: wo(4), wh(4)
        wo = lo32(o)
        wh = lo32(h)
        call seed_f(wo, wh)
        o = u64(wo)
        h = u64(wh)
    end subroutine

    attributes(host, device) subroutine tandem_dev_F_keyed(key, counter, domain, aux, o, h)
        integer(int64), intent(in) :: key(4), counter, domain, aux
        integer(int64), intent(out) :: o(4), h(4)
        integer(int32) :: wo(4), wh(4)
        integer(int32) :: wk(4)
        wk = lo32(key)
        call f_keyed(wk, counter, domain, aux, wo, wh)
        o = u64(wo)
        h = u64(wh)
    end subroutine

    ! Block B(c, j): the exposed half of chunk c after j + 1 steps.
    attributes(host, device) subroutine tandem_dev_block(key, c, j, out)
        integer(int64), intent(in) :: key(4), c, j
        integer(int64), intent(out) :: out(4)
        integer(int32) :: w(4), wk(4)
        wk = lo32(key)
        call block_words(wk, c, j, w)
        out = u64(w)
    end subroutine

    ! The 64-bit product of two words held as int64 values in [0, 2^32), for the bounded draws.
    ! With b = bh 2^16 + bl, a bl and a bh stay below 2^48, so every intermediate fits.
    attributes(host, device) subroutine mul32(a, b, lo, hi)
        integer(int64), intent(in) :: a, b
        integer(int64), intent(out) :: lo, hi
        integer(int64) :: p0, p1, t
        p0 = a * iand(b, int(z'ffff', int64))
        p1 = a * ishft(b, -16)
        t = iand(p0, M32) + ishft(iand(p1, int(z'ffff', int64)), 16)
        lo = iand(t, M32)
        hi = iand(ishft(p0, -32) + ishft(p1, -16) + ishft(t, -32), M32)
    end subroutine

    ! The int32 with the bit pattern of a word in [0, 2^32).
    attributes(host, device) function bits32(w) result(x)
        integer(int64), intent(in) :: w
        integer(int32) :: x
        x = int(w - 2 * iand(w, 2_int64**31), int32)
    end function

    ! trailz is not available in device code.
    attributes(host, device) function log2k(K) result(s)
        integer(int64), intent(in) :: K
        integer :: s
        s = 0
        do while (ishft(K, -s) > 1)
            s = s + 1
        end do
    end function

    attributes(host, device) function from_words(w, pos, K) result(rng)
        integer(int32), intent(in) :: w(4)
        integer(int64), intent(in) :: pos
        integer(int32), intent(in) :: K
        type(tandem_dev_t) :: rng
        rng%key = u64(w)
        rng%pos = pos
        rng%K = K
        if (K == 0) rng%K = 32
        rng%lk = log2k(rng%K)
        rng%chunk = 0
        rng%step = 0
        rng%blk = -1
        rng%o = 0
        rng%h = 0
        rng%live = .false.
    end function

    ! K is a power of two in [1, 65536]; 0 means the default of 32.
    attributes(host, device) function tandem_dev_from_key(key, pos, K) result(rng)
        integer(int32), intent(in) :: key(4)
        integer(int64), intent(in) :: pos
        integer(int32), intent(in) :: K
        type(tandem_dev_t) :: rng
        rng = from_words(key, pos, K)
    end function

    attributes(host, device) function tandem_dev_seed(seed_lo, seed_hi, K) result(rng)
        integer(int64), intent(in) :: seed_lo, seed_hi
        integer(int32), intent(in) :: K
        type(tandem_dev_t) :: rng
        integer(int32) :: o(4), h(4)
        o = [0, 0, lo32(DOMAIN_SEED), 0]
        h = [lo32(seed_lo), lo32(ishft(seed_lo, -32)), lo32(seed_hi), lo32(ishft(seed_hi, -32))]
        call seed_f(o, h)
        rng = from_words(o, 0_int64, K)
    end function

    attributes(host, device) subroutine tandem_dev_skip_to(rng, pos)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int64), intent(in) :: pos
        rng%pos = pos
    end subroutine

    ! Bring the cache to the block that holds stream bit p. A draw from the cached block costs one
    ! compare, stepping forward inside the cached chunk one T per block, and any other move
    ! reseeds.
    attributes(host, device) subroutine load(rng, p)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int64), intent(in) :: p
        integer(int64) :: row, j, c
        integer(int32) :: wk(4)
        if (ishft(p, -7) == rng%blk) return
        rng%blk = ishft(p, -7)
        row = ishft(p, -10)
        j = iand(row, rng%K - 1)
        c = 8 * ishft(row, -rng%lk) + iand(ishft(p, -7), 7_int64)
        if (.not. rng%live .or. c /= rng%chunk .or. j < rng%step) then
            wk = lo32(rng%key)
            call f_keyed(wk, c, TANDEM_DOMAIN_STREAM, TANDEM_AUX_STREAM, rng%o, rng%h)
            call step(rng%o, rng%h)
            rng%chunk = c
            rng%step = 0
            rng%live = .true.
        end if
        do while (rng%step < j)
            call step(rng%o, rng%h)
            rng%step = rng%step + 1
        end do
    end subroutine

    ! Draw w bits (a power of two, 1 to 64): align, advance, read. A 64-bit draw comes back as
    ! its int64 bit pattern.
    attributes(host, device) function next_bits(rng, w) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        integer, intent(in) :: w
        integer(int64) :: x, p
        integer :: i
        p = iand(rng%pos + (w - 1), not(int(w - 1, int64)))
        rng%pos = p + w
        call load(rng, p)
        i = int(iand(ishft(p, -5), 3_int64)) + 1
        if (w == 64) then
            x = ior(u64(rng%o(i)), ishft(int(rng%o(i + 1), int64), 32))
        else
            x = iand(ishft(u64(rng%o(i)), -int(iand(p, 31_int64))), ishft(M32, w - 32))
        end if
    end function

    ! Word k (0 to 3) of the cached block, by selects: an index into o would put the cache in
    ! local memory on a device.
    attributes(host, device) function word_at(rng, k) result(x)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: k
        integer(int32) :: x
        x = merge(merge(rng%o(1), rng%o(2), k == 0), merge(rng%o(3), rng%o(4), k == 2), k < 2)
    end function

    ! The next 32-bit word as its int32 bit pattern, as next_bits(rng, 32).
    attributes(host, device) function next_word(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int32) :: x
        integer(int64) :: p
        p = iand(rng%pos + 31, not(31_int64))
        rng%pos = p + 32
        call load(rng, p)
        x = word_at(rng, iand(ishft(p, -5), 3_int64))
    end function

    ! The next 64-bit draw as its int64 bit pattern, as next_bits(rng, 64).
    attributes(host, device) function next_dword(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int64) :: x
        integer(int64) :: p
        p = iand(rng%pos + 63, not(63_int64))
        rng%pos = p + 64
        call load(rng, p)
        if (btest(p, 6)) then
            x = ior(u64(rng%o(3)), ishft(int(rng%o(4), int64), 32))
        else
            x = ior(u64(rng%o(1)), ishft(int(rng%o(2), int64), 32))
        end if
    end function

    attributes(host, device) function tandem_dev_next_real64(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        real(real64) :: x
        x = real(ishft(next_dword(rng), -11), real64) * 2.0_real64**(-53)
    end function

    attributes(host, device) function tandem_dev_next_real32(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        real(real32) :: x
        x = real(ishft(next_word(rng), -8), real32) * 2.0_real32**(-24)
    end function

    attributes(host, device) function tandem_dev_next_int64(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int64) :: x
        x = next_dword(rng)
    end function

    attributes(host, device) function tandem_dev_next_int32(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int32) :: x
        x = next_word(rng)
    end function

    attributes(host, device) function tandem_dev_next_logical(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        logical :: x
        x = next_bits(rng, 1) /= 0
    end function

    attributes(host, device) function child(rng, counter, domain, aux, hidden) result(c)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: counter, domain, aux
        logical, intent(in) :: hidden
        type(tandem_dev_t) :: c
        integer(int32) :: o(4), h(4), wk(4)
        wk = lo32(rng%key)
        call f_keyed(wk, counter, domain, aux, o, h)
        if (hidden) then
            c = from_words(h, 0_int64, int(rng%K, int32))
        else
            c = from_words(o, 0_int64, int(rng%K, int32))
        end if
    end function

    ! Child by index, from the key alone.
    attributes(host, device) function tandem_dev_split(rng, index) result(c)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: index
        type(tandem_dev_t) :: c
        c = child(rng, ishft(index, -1), DOMAIN_SPLIT, 0_int64, btest(index, 0))
    end function

    ! Child for a purpose, from the key alone.
    attributes(host, device) function tandem_dev_sub(rng, purpose) result(c)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: purpose
        type(tandem_dev_t) :: c
        c = child(rng, purpose, DOMAIN_FOLD, 0_int64, .false.)
    end function

    ! n children from the current block, then the position moves past that block.
    attributes(host, device) subroutine tandem_dev_fork(rng, children, n)
        type(tandem_dev_t), intent(inout) :: rng
        integer, intent(in) :: n
        type(tandem_dev_t), intent(out) :: children(n)
        integer(int64) :: b
        integer :: i
        b = ishft(rng%pos, -7)
        do i = 0, n - 1
            children(i + 1) = child(rng, b, DOMAIN_FORK, int(i / 2, int64), btest(i, 0))
        end do
        rng%pos = ishft(b + 1, 7)
    end subroutine

    ! Random access: element i of the fill that would start at the position, which does not
    ! move. The word comes from the block directly, so the cache is untouched.
    attributes(host, device) function at_bits(rng, i, w) result(x)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: i
        integer, intent(in) :: w
        integer(int64) :: x, p, row
        integer(int32) :: b(4), wk(4)
        integer :: k
        p = iand(rng%pos + (w - 1), not(int(w - 1, int64))) + i * w
        row = ishft(p, -10)
        wk = lo32(rng%key)
        call block_words(wk, 8 * ishft(row, -rng%lk) + iand(ishft(p, -7), 7_int64), &
            iand(row, rng%K - 1), b)
        k = int(iand(ishft(p, -5), 3_int64)) + 1
        if (w == 64) then
            x = ior(u64(b(k)), ishft(int(b(k + 1), int64), 32))
        else
            x = u64(b(k))
        end if
    end function

    attributes(host, device) function tandem_dev_at_real64(rng, i) result(x)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: i
        real(real64) :: x
        x = real(ishft(at_bits(rng, i, 64), -11), real64) * 2.0_real64**(-53)
    end function

    attributes(host, device) function tandem_dev_at_real32(rng, i) result(x)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: i
        real(real32) :: x
        x = real(ishft(at_bits(rng, i, 32), -8), real32) * 2.0_real32**(-24)
    end function

    attributes(host, device) function tandem_dev_at_int64(rng, i) result(x)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: i
        integer(int64) :: x
        x = at_bits(rng, i, 64)
    end function

    attributes(host, device) function tandem_dev_at_int32(rng, i) result(x)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: i
        integer(int32) :: x
        x = bits32(at_bits(rng, i, 32))
    end function

    ! The 128-bit product of two 64-bit words as low and high words, from 32-bit pieces so that
    ! every sum stays inside int64.
    attributes(host, device) subroutine mul64(a, b, lo, hi)
        integer(int64), intent(in) :: a, b
        integer(int64), intent(out) :: lo, hi
        integer(int64) :: ll0, ll1, lh0, lh1, hl0, hl1, hh0, hh1, mid, up
        call mul32(iand(a, M32), iand(b, M32), ll0, ll1)
        call mul32(iand(a, M32), iand(ishft(b, -32), M32), lh0, lh1)
        call mul32(iand(ishft(a, -32), M32), iand(b, M32), hl0, hl1)
        call mul32(iand(ishft(a, -32), M32), iand(ishft(b, -32), M32), hh0, hh1)
        mid = ll1 + lh0 + hl0
        up = hh0 + lh1 + hl1 + ishft(mid, -32)
        lo = ior(ll0, ishft(iand(mid, M32), 32))
        hi = ior(iand(up, M32), ishft(iand(hh1 + ishft(up, -32), M32), 32))
    end subroutine

    attributes(host, device) function unsigned_less(a, b) result(r)
        integer(int64), intent(in) :: a, b
        logical :: r
        r = ieor(a, SIGN) < ieor(b, SIGN)
    end function

    ! (2^64 - n) mod n for n > 0, by shift and subtract: it runs only after a rejected draw.
    ! Starting from 2^64 - 1 - n avoids a negation that would wrap.
    attributes(host, device) function threshold64(n) result(t)
        integer(int64), intent(in) :: n
        integer(int64) :: t, a
        integer :: i
        logical :: top
        a = not(n)
        t = 0
        do i = 63, 0, -1
            top = btest(t, 63)
            t = ior(ishft(t, 1), iand(ishft(a, -i), 1_int64))
            if (top .or. .not. unsigned_less(t, n)) t = t - n
        end do
        t = t + 1
        if (t == n) t = 0
    end function

    ! Uniform on [0, n) by Lemire's multiply and reject, as Rng::urand(range). n is an unsigned
    ! bit pattern, and n = 0 returns 0 after one draw, as the C library does.
    attributes(host, device) function tandem_dev_below_int32(rng, n) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int32), intent(in) :: n
        integer(int32) :: x
        integer(int64) :: r, lo, hi, t
        r = iand(int(n, int64), M32)
        call mul32(next_bits(rng, 32), r, lo, hi)
        if (lo < r) then
            t = mod(M32 + 1 - r, r)
            do while (lo < t)
                call mul32(next_bits(rng, 32), r, lo, hi)
            end do
        end if
        x = bits32(hi)
    end function

    attributes(host, device) function tandem_dev_below_int64(rng, n) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        integer(int64), intent(in) :: n
        integer(int64) :: x, lo, hi, t
        call mul64(next_bits(rng, 64), n, lo, hi)
        if (unsigned_less(lo, n)) then
            t = threshold64(n)
            do while (unsigned_less(lo, t))
                call mul64(next_bits(rng, 64), n, lo, hi)
            end do
        end if
        x = hi
    end function

    ! L(x) = -2 ln x for normal x in (0, 1], the reference logarithm of spec Appendix A. The C
    ! reference splits x = m 2^k with m in [M0, 2 M0) by adding bits to its exponent field,
    ! M0 = 1 / 2 + 0x6a09e 2^-21, close to sqrt(1/2). fraction and exponent give the same exact m
    ! and k without a bit cast, which nvfortran 25.3 cannot link in host code here. Products
    ! feed sums only through fmad, so contraction cannot change the bits.
    attributes(host, device) function neg2_log(x) result(L)
        real(real64), intent(in) :: x
        real(real64), parameter :: TWO_M0 = 1.0_real64 + 434334.0_real64 * 2.0_real64**(-20)
        real(real64) :: L, nk, mant, s, z, p
        mant = 2.0_real64 * fraction(x) ! in [1, 2), x = mant 2^(exponent(x) - 1)
        nk = real(1 - exponent(x), real64)
        if (mant >= TWO_M0) then
            mant = 0.5_real64 * mant
            nk = nk - 1.0_real64
        end if
        s = (mant - 1.0_real64) / (mant + 1.0_real64)
        z = s * s
        p = fmad(z, fmad(z, fmad(z, fmad(z, fmad(z, fmad(z, LOG_C(6), LOG_C(5)), LOG_C(4)), &
            LOG_C(3)), LOG_C(2)), LOG_C(1)), 1.0_real64)
        L = fmad(nk, LN2X2_LO, fmad(nk, LN2X2_HI, (s * (-4.0_real64)) * p))
    end function

    ! The fast path of the 64-bit draw r: the value +-ra W(i), exact also on a miss, and whether
    ! ra < K(i). Bits 0-9 pick the layer, bit 10 the sign, bits 11-63 are ra. The negation flips
    ! the sign bit, so ra = 0 with the sign set gives -0.0.
    attributes(host, device) function zig_fast(r, hit) result(x)
        integer(int64), intent(in) :: r
        logical, intent(out) :: hit
        real(real64) :: x
        integer(int64) :: ra
        integer :: i
        i = int(iand(r, 1023_int64))
        ra = ishft(r, -11)
        hit = ra < ZIG_K(i)
        x = real(ra, real64) * ZIG_W(i)
        if (btest(r, 10)) x = -x
    end function

    ! The continuation of a miss (spec Appendix A) on split(g) of sub(PURPOSE_NORMAL64) of the
    ! key at position 0, g the global index of draw r. Every product goes through fmad with a
    ! zero addend, so it rounds once, and parentheses keep the compiler from reassociating.
    attributes(host, device) function zig_slow(rng, r0, g) result(x)
        type(tandem_dev_t), intent(in) :: rng
        integer(int64), intent(in) :: r0, g
        real(real64) :: x, a, b, y
        type(tandem_dev_t) :: fb
        integer(int64) :: r
        integer :: i
        logical :: hit
        fb = tandem_dev_split(tandem_dev_sub(rng, PURPOSE_NORMAL64), g)
        r = r0
        x = zig_fast(r, hit)
        do
            i = int(iand(r, 1023_int64))
            if (i == 0) then ! the tail beyond R, Marsaglia's method
                do
                    a = (0.5_real64 * neg2_log(1.0_real64 - tandem_dev_next_real64(fb))) / ZIG_R
                    b = 0.5_real64 * neg2_log(1.0_real64 - tandem_dev_next_real64(fb))
                    if (b + b >= fmad(a, a, 0.0_real64)) exit
                end do
                x = ZIG_R + a
                if (btest(r, 10)) x = -x
                return
            end if
            y = ZIG_Y(i) + fmad(tandem_dev_next_real64(fb), ZIG_Y(i + 1) - ZIG_Y(i), 0.0_real64)
            if (-0.5_real64 * neg2_log(y) < -0.5_real64 * fmad(x, x, 0.0_real64)) return
            r = next_dword(fb)
            x = zig_fast(r, hit)
            if (hit) return
        end do
    end function

    ! Standard normal by the 1024-layer ziggurat from one 64-bit draw, as Rng::normal, bit for
    ! bit equal to the C library's. A miss leaves the position alone.
    attributes(host, device) function tandem_dev_next_normal64(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        real(real64) :: x
        integer(int64) :: r, g
        logical :: hit
        g = ishft(iand(rng%pos + 63, not(63_int64)), -6)
        r = next_dword(rng)
        x = zig_fast(r, hit)
        if (.not. hit) x = zig_slow(rng, r, g)
    end function

    ! The same in single precision from two real32 draws, as Rng::normalf. The angle goes
    ! through double, as the host does, because a float angle is off by up to 2 pi b 2^-24.
    attributes(host, device) function tandem_dev_next_normal32(rng) result(x)
        type(tandem_dev_t), intent(inout) :: rng
        real(real32) :: x, a, b
        real(real64) :: t
        a = tandem_dev_next_real32(rng)
        b = tandem_dev_next_real32(rng)
        t = 6.283185307179586_real64 * real(b, real64)
        x = sqrt(-2.0_real32 * log(1.0_real32 - a)) * real(cos(t), real32)
    end function

    ! Both halves of one single-precision step, cos first, as Rng::normalf2.
    attributes(host, device) function tandem_dev_next_normal_pair32(rng) result(z)
        type(tandem_dev_t), intent(inout) :: rng
        real(real32) :: z(2), a, b, r
        real(real64) :: t
        a = tandem_dev_next_real32(rng)
        b = tandem_dev_next_real32(rng)
        r = sqrt(-2.0_real32 * log(1.0_real32 - a))
        t = 6.283185307179586_real64 * real(b, real64)
        z(1) = r * real(cos(t), real32)
        z(2) = r * real(sin(t), real32)
    end function

end module tandem_rng_device
