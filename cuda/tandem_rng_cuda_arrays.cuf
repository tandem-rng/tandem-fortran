        type(tandem_t), intent(inout) :: rng
        integer(int64), device, contiguous :: x(:, :)
        integer, intent(out), optional :: stat
        call fill_ptr_int64(rng, address(c_devloc(x)), size(x, kind=int64), stat)
    end subroutine

    subroutine fill_int64_3(rng, x, stat)
        type(tandem_t), intent(inout) :: rng
        integer(int64), device, contiguous :: x(:, :, :)
        integer, intent(out), optional :: stat
        call fill_ptr_int64(rng, address(c_devloc(x)), size(x, kind=int64), stat)
    end subroutine

