        type(tandem_t), intent(inout) :: rng
        integer(int32), device, contiguous :: x(:)
        type(tandem_device_choice_t), intent(in) :: table
        integer, intent(out), optional :: stat
        call fill_ptr_choice(rng, address(c_devloc(x)), size(x, kind=int64), table, stat)
    end subroutine

