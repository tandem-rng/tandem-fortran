    end subroutine

    ! c_devptr wraps the same address as a c_ptr.
    function address(d) result(p)
        use cudafor, only: c_devptr
        type(c_devptr), intent(in) :: d
        type(c_ptr) :: p
        p = transfer(d, c_null_ptr)
    end function

end module tandem_rng_cuda_arrays
