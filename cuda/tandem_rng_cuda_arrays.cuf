        type(tandem_t), intent(inout) :: rng
        integer(int32), device, contiguous :: x(:)
        integer(int32), intent(in) :: bound
        integer, intent(out), optional :: stat
        call fill_ptr_below_int32(rng, address(c_devloc(x)), size(x, kind=int64), bound, stat)
