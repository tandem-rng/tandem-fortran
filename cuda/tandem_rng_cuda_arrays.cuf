        type(tandem_t), intent(inout) :: rng
        integer(int32), device, contiguous :: x(:, :)
        integer, intent(out), optional :: stat
        call fill_ptr_int32(rng, address(c_devloc(x)), size(x, kind=int64), stat)
    end subroutine

    subroutine fill_int32_3(rng, x, stat)
        type(tandem_t), intent(inout) :: rng
        integer(int32), device, contiguous :: x(:, :, :)
        integer, intent(out), optional :: stat
        call fill_ptr_int32(rng, address(c_devloc(x)), size(x, kind=int64), stat)
    end subroutine

    subroutine fill_int16_1(rng, x, stat)
        type(tandem_t), intent(inout) :: rng
        integer(int16), device, contiguous :: x(:)
        integer, intent(out), optional :: stat
